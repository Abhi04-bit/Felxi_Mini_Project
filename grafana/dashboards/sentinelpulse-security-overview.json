{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "SentinelPulse security signals, monitoring service health, and active Prometheus alerts.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Total failed SSH login events observed in the selected dashboard time range. If the exporter has no samples in this range, the panel reports no data.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "noValue": "No samples in range",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "background_solid",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "13.2.4",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum(increase(failed_ssh_logins_total[$__range]))",
          "instant": true,
          "legendFormat": "Failed SSH logins",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Failed SSH logins · selected range",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Failed SSH login events per rolling query interval. The selected dashboard range controls the time axis; the exporter must have been scraped to produce samples.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Failed login events per interval",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 15,
            "gradientMode": "opacity",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 4,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "noValue": "No trend samples yet",
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 6 },
      "id": 2,
      "options": {
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "hideZeros": false, "mode": "multi", "sort": "desc" }
      },
      "pluginVersion": "13.2.4",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum(increase(failed_ssh_logins_total[$__rate_interval]))",
          "instant": false,
          "legendFormat": "Failed SSH logins",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Failed-login trend",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Prometheus scrape health for the exporter, Prometheus, Alertmanager, and Grafana. UP means the target answered its metrics scrape; DOWN means Prometheus has a failed scrape. A missing target series means Prometheus has not scraped that target yet or the data source is unavailable.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "options": {
                "0": { "color": "red", "index": 0, "text": "DOWN" },
                "1": { "color": "green", "index": 1, "text": "UP" }
              },
              "type": "value"
            }
          ],
          "noValue": "No scrape data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 16, "x": 8, "y": 0 },
      "id": 3,
      "options": {
        "colorMode": "background_solid",
        "graphMode": "none",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "value_and_name",
        "wideLayout": true
      },
      "pluginVersion": "13.2.4",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "up{job=~\"sentinelpulse-exporter|prometheus|alertmanager|grafana\"}",
          "instant": true,
          "legendFormat": "{{job}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Exporter & monitoring availability",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Prometheus alert rules currently in pending or firing state. An empty result means no active alert series has been observed yet; a query error or unavailable data source is shown separately by Grafana.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false },
          "mappings": [],
          "noValue": "No active alert series",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "yellow", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 6 },
      "id": 4,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true,
        "sortBy": []
      },
      "pluginVersion": "13.2.4",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "ALERTS{alertstate=~\"pending|firing\"}",
          "format": "table",
          "instant": true,
          "legendFormat": "{{alertname}} · {{alertstate}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Active alert states",
      "transformations": [
        { "id": "labelsToFields", "options": { "mode": "columns" } }
      ],
      "type": "table"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "HTTPS target probe results. UP means the HTTPS request and verified TLS handshake succeeded; DOWN means the probe failed. No samples means no target result is available.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "options": { "0": { "color": "red", "index": 0, "text": "DOWN" }, "1": { "color": "green", "index": 1, "text": "HTTPS UP" } }, "type": "value" }
          ],
          "noValue": "No HTTPS probe metrics",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 15 },
      "id": 5,
      "options": {
        "colorMode": "background_solid",
        "graphMode": "none",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "value_and_name",
        "wideLayout": true
      },
      "pluginVersion": "13.2.4",
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "editorMode": "code",
        "expr": "probe_success{job=\"blackbox-https\"}",
        "instant": true,
        "legendFormat": "{{target_name}} · {{instance}}",
        "range": false,
        "refId": "A"
      }],
      "title": "HTTPS probe status",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Days remaining until expiry for certificates from successful HTTPS probes. Failed or missing probes are excluded, so missing data is not presented as a healthy expiry.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "noValue": "No verified certificate expiry",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 7 }, { "color": "green", "value": 14 }] },
          "unit": "d"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 15 },
      "id": 6,
      "options": {
        "colorMode": "background_solid",
        "graphMode": "none",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "value_and_name",
        "wideLayout": true
      },
      "pluginVersion": "13.2.4",
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "editorMode": "code",
        "expr": "(probe_ssl_earliest_cert_expiry{job=\"blackbox-https\"} - time()) / 86400 and on(instance) (probe_success{job=\"blackbox-https\"} == 1)",
        "instant": true,
        "legendFormat": "{{target_name}} · {{instance}}",
        "range": false,
        "refId": "A"
      }],
      "title": "TLS certificate expiry countdown",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Expiry date/time for certificates from successful HTTPS probes. Prometheus epoch seconds are converted to milliseconds for Grafana's ISO date-time unit.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed" },
          "mappings": [],
          "noValue": "No verified TLS expiry timestamp",
          "unit": "dateTimeAsIso"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 15 },
      "id": 7,
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "value_and_name",
        "wideLayout": true
      },
      "pluginVersion": "13.2.4",
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "editorMode": "code",
        "expr": "probe_ssl_earliest_cert_expiry{job=\"blackbox-https\"} * 1000 and on(instance) (probe_success{job=\"blackbox-https\"} == 1)",
        "instant": true,
        "legendFormat": "{{target_name}} · {{instance}}",
        "range": false,
        "refId": "A"
      }],
      "title": "TLS certificate expiry date",
      "type": "stat"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["sentinelpulse", "security", "monitoring"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["15s", "30s", "1m", "5m", "15m", "1h"],
    "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "7d", "30d"]
  },
  "timezone": "browser",
  "title": "SentinelPulse Security Overview",
  "uid": "sentinelpulse-security-overview",
  "version": 1
}
